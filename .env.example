# Create a NEW Firebase project; never use the integrated app project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional, local testing only:
VITE_USE_EMULATORS=false
VITE_FEEDBACK_WEBHOOK_URL=
VITE_APP_VERSION=listening-1
VITE_SITE_URL=https://your-app.example.com
# Web ログインを同じドメインで行う（vercel.json の /__/auth 中継を使う）。
# Google / Apple の管理画面に https://<このドメイン>/__/auth/handler を登録してから true にする。docs/WEB_LOGIN_SAME_ORIGIN.md
VITE_AUTH_SAME_ORIGIN=false
# ↑ だけでは切り替わらない（2026-10-23）。Apple Developer の Services ID に
#   Domains=<このドメイン> と Return URL=https://<このドメイン>/__/auth/handler を登録してから、こちらも true にする。
#   片方だけ true なら従来どおり firebaseapp.com でログインする（Apple が壊れないための安全装置）。
VITE_AUTH_SAME_ORIGIN_APPLE_READY=false
