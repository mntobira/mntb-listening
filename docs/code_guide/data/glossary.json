[
 {"term":"コンポーネント（component）","plain":"画面の部品。ボタンやカードなど、組み合わせて画面を作る単位","where":"src/components/ の .tsx"},
 {"term":"画面（AppState）","plain":"アプリが今どの画面を出しているかの名札。全18種類","where":"src/App.tsx"},
 {"term":"フック（hook）","plain":"画面の部品に「覚える・見張る」働きを足す小さな道具","where":"src/hooks/ と use〜 で始まるファイル"},
 {"term":"型（type / interface）","plain":"データの形の決まり。どんな項目を持つかを書いた設計図","where":"src/types/、battle/core/types.ts"},
 {"term":"純粋関数","plain":"同じ入力なら必ず同じ答えを返す計算。通信や画面に触れない","where":"battle/core/、utils/ の多く"},
 {"term":"Firebase","plain":"Googleが提供する、ログインとデータ保存のしくみ一式","where":"src/firebase.ts"},
 {"term":"Firestore","plain":"Firebaseのデータ保存先（ネット上の台帳）。図鑑では「データ保存先」","where":"firestore.rules・utils/*Sync など"},
 {"term":"セキュリティルール（firestore.rules）","plain":"データ保存先で、誰がどのデータを読み書きできるかの決まり","where":"firestore.rules"},
 {"term":"Cloud Functions","plain":"サーバー側で動く処理。図鑑では「サーバー処理」","where":"functions/"},
 {"term":"localStorage","plain":"端末（ブラウザ）の中の小さな保存場所。図鑑では「端末の保存領域」","where":"utils/safeLocalStorage.ts など"},
 {"term":"同期（sync）","plain":"端末の記録とデータ保存先の記録を、同じ内容にそろえること","where":"utils/studySync.ts など"},
 {"term":"Capacitor","plain":"Webで作ったアプリを、iPhone・Androidのアプリとして包む道具","where":"capacitor.config.ts・ios/・android/"},
 {"term":"WebView","plain":"スマホアプリの中でWeb画面を表示する窓","where":"android/ の RangeAwareWebViewClient"},
 {"term":"Range（範囲）要求","plain":"音声ファイルの「途中から」を取り寄せる頼み方","where":"RangeAwareWebViewClient.java"},
 {"term":"Vite / ビルド","plain":"書いたコードを、配れる形にまとめて組み立てる作業とその道具","where":"vite.config.ts・scripts/build.sh"},
 {"term":"テスト（vitest / Playwright）","plain":"決まりどおりに動くかを自動で確かめるしくみ。Playwrightは実際のブラウザを使う","where":"tests/"},
 {"term":"自動生成ファイル（generated）","plain":"スクリプトが元データから作るファイル。手では直さない","where":"*.generated.ts"},
 {"term":"出題プール（pool）","plain":"対戦で出す問題の一覧","where":"src/battle/data/pool.*.generated.ts"},
 {"term":"レート（Elo）","plain":"対戦の強さを表す点数。勝つと上がり、負けると下がる","where":"battle/data/battleRanking.ts"},
 {"term":"マッチング","plain":"全国対戦で、対戦相手を見つけて組み合わせること","where":"battle/data/battleMatchmaking.ts"},
 {"term":"忘却曲線・間隔反復","plain":"人が忘れていく速さに合わせ、間をあけて復習日を決める考え方","where":"utils/reviewList.ts"},
 {"term":"サニタイズ","plain":"表示する文章から危ない書き方を取り除くこと","where":"utils/sanitizeHtml.ts"},
 {"term":"ポリフィル（polyfill）","plain":"古い端末に足りない機能を、あとから補う部品","where":"utils/polyfills.ts"},
 {"term":"Service Worker","plain":"電波が弱いときのために、画面や音を端末に取っておく裏方","where":"public/sw.js"},
 {"term":"CSP（Content-Security-Policy）","plain":"ページが通信してよい相手を限る、安全のための決まり","where":"public/_headers・vite.config.ts"},
 {"term":"TTS / 読み上げ","plain":"文字を音声にすること。端末の読み上げは音源が無いときの代わり","where":"utils/listeningSpeech.ts"},
 {"term":"KaTeX","plain":"数式をきれいに組んで表示する部品","where":"utils/mathTypeset.ts・index.css"},
 {"term":"AdMob","plain":"Googleのアプリ内広告のしくみ","where":"utils/adConfig.ts・utils/adService.ts"},
 {"term":"フィーチャーフラグ","plain":"機能を公開する・隠すを切り替えるスイッチ","where":"config/features.ts"},
 {"term":"遅延読み込み（lazy）","plain":"画面を開いたときに初めて、その部品を読み込むこと","where":"App.tsx・ListeningSubjectSelection.tsx"}
]
